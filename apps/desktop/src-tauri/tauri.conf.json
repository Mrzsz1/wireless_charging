{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Wireless Charging Research Workbench",
  "version": "0.7.2",
  "identifier": "com.wirelesscharging.research-workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Wireless Charging Research Workbench",
        "width": 1366,
        "height": 768,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QTYzRjg1ODMwODhBQUIKUldTcmlnaURoVCttcVBzd3piTmhvbGJSUEFta2RVbmJIQVduUUpQRFBvY25uRjBwYUZ6S2p6NnIK"
    }
  }
}
