{
  "name": "desktop",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:build": "py -3 ../../tools/export_desktop_data.py",
    "build": "npm run data:build && tsc && vite build",
    "verify": "node scripts/verify-build.mjs",
    "verify:p3": "node scripts/verify-p3.mjs",
    "verify:p4": "node scripts/verify-p4.mjs",
    "tauri": "tauri",
    "preview": "vite preview",
    "verify:p5": "node scripts/verify-p5.mjs",
    "smoke:installer": "node scripts/smoke-installer.mjs",
    "e2e:gui": "node e2e/gui-smoke.mjs",
    "e2e:gui:strict": "node e2e/gui-smoke.mjs --strict",
    "test:e2e-config": "node --test tests/gui-e2e-config.test.mjs",
    "test:installer-lifecycle": "node --test tests/process-lifecycle.test.mjs",
    "verify:p5:strict": "node scripts/verify-p5.mjs --strict",
    "test:p1": "node --experimental-strip-types --test tests/p1-state.test.ts",
    "test:p2": "node --experimental-strip-types --test tests/search-state.test.ts",
    "test:research-trail": "node --experimental-strip-types --test tests/research-trail-state.test.ts",
    "test:ingest": "node --experimental-strip-types --test tests/ingest-state.test.ts",
    "release:signed": "node scripts/build-signed-release.mjs",
    "fixture:updater": "node scripts/updater-fixture-server.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "webdriverio": "^9.30.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
